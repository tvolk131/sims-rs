// Shared plumbing fixture template with occupancy lock, wear-to-broken state, and repair finish.

pub template PlumbingFixture {
    category: plumbing;

    param break_threshold: i16 = 3;
    param use_ticks: i16 = 2;
    param max_use_cycles: i16 = 4;
    param motive_step: i16 = 35;
    param max_entry_motive: i16 = 95;
    param repair_ticks: i16 = 2;
    param mechanic_xp: i16 = 15;

    state occupied: bool = false;
    state wear: i16 = 0;
    state broken: bool = false;

    slot front = routing([0.0, -0.70, 0.0]);

    fn complete_fixture_repair(sim: Sim, confirm_sfx: Sound) {
        self.broken = false;
        self.wear = 0;
        sim.skill.mechanical += mechanic_xp;
        play_sound(confirm_sfx);
    }
}
