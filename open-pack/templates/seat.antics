// Shared seating template for benches, dining chairs, and sofas.

use crate::common::helpers::restore_motive_loop;

pub template SeatBase {
    category: seating;

    param sit_ticks: i16 = 2;
    param sit_cycles: i16 = 3;
    param comfort_step: i16 = 18;
    param max_entry_comfort: i16 = 95;

    state occupied: bool = false;

    sound creak = preset("wood_creak");

    slot seat_entry = routing([0.0, -0.75, 0.0], sitting: true);

    fn sit_comfort_loop(sim: Sim) -> i16 {
        return restore_motive_loop(
            sim,
            Motive::Comfort,
            cycles: sit_cycles,
            step: comfort_step,
            ticks: sit_ticks,
        );
    }
}
