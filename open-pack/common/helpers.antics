// Shared clean-room behavioral helpers for `open-pack/`. The motive and repair loops delegate to
// the built-in `std::motives`.

use std::motives::repair_by_progress as std_repair_by_progress;
use std::motives::restore_motive_tracked as std_restore_motive_tracked;
use std::motives::restore_two_motives_tracked as std_restore_two_motives_tracked;

/// Cancel-safe single-motive restoration loop with per-cycle counter updates
/// (`std::motives::restore_motive_tracked`).
pub fn restore_motive_tracked(
    sim: Sim,
    motive: Motive,
    cycles: i16,
    step: i16,
    completed: &mut i16,
    ticks: i16 = 2,
    cap: i16 = 100,
) {
    std_restore_motive_tracked(
        sim,
        motive,
        cycles: cycles,
        step: step,
        completed: completed,
        ticks: ticks,
        cap: cap,
    );
}

/// Cancel-safe single-motive restoration loop returning the number of completed cycles
/// (`std::motives::restore_motive_loop`, inlined the same way).
pub fn restore_motive_loop(
    sim: Sim,
    motive: Motive,
    cycles: i16,
    step: i16,
    ticks: i16 = 2,
    cap: i16 = 100,
) -> i16 {
    let mut completed: i16 = 0;
    std_restore_motive_tracked(
        sim,
        motive,
        cycles: cycles,
        step: step,
        completed: &mut completed,
        ticks: ticks,
        cap: cap,
    );
    completed
}

/// Cancel-safe dual-motive restoration loop with per-cycle counter updates
/// (`std::motives::restore_two_motives_tracked`).
pub fn restore_two_motives_tracked(
    sim: Sim,
    primary: Motive,
    primary_step: i16,
    secondary: Motive,
    secondary_step: i16,
    cycles: i16,
    completed: &mut i16,
    ticks: i16 = 2,
    primary_cap: i16 = 100,
) {
    std_restore_two_motives_tracked(
        sim,
        primary,
        primary_step,
        secondary,
        secondary_step,
        cycles: cycles,
        completed: completed,
        ticks: ticks,
        primary_cap: primary_cap,
    );
}

/// Cancel-safe dual-motive restoration loop returning the number of completed cycles
/// (`std::motives::restore_two_motives_loop`, inlined the same way).
pub fn restore_two_motives_loop(
    sim: Sim,
    primary: Motive,
    primary_step: i16,
    secondary: Motive,
    secondary_step: i16,
    cycles: i16,
    ticks: i16 = 2,
    primary_cap: i16 = 100,
) -> i16 {
    let mut completed: i16 = 0;
    std_restore_two_motives_tracked(
        sim,
        primary,
        primary_step,
        secondary,
        secondary_step,
        cycles: cycles,
        completed: &mut completed,
        ticks: ticks,
        primary_cap: primary_cap,
    );
    completed
}

/// Sets a boolean toggle/power/lock state and plays the associated object sound.
pub fn set_toggle_state(flag: &mut bool, enabled: bool, sfx: Sound) {
    *flag = enabled;
    play_sound(sfx);
}

/// Increments a fixture's wear counter and transitions it to broken once `threshold` is reached.
/// Returns `true` if the fixture broke on this use.
pub fn record_fixture_wear(wear: &mut i16, broken: &mut bool, threshold: i16) -> bool {
    *wear += 1;
    if *wear >= threshold {
        *broken = true;
        return true;
    }
    return false;
}

/// Cancel-safe Mechanical-skill-scaled repair loop (`std::motives::repair_by_progress`).
/// Returns `true` if repair progress reached `goal` (not canceled early).
pub fn repair_by_progress(
    sim: Sim,
    goal: i16,
    base_step: i16,
    mechanic_divisor: i16,
    cycles_out: &mut i16,
    ticks: i16 = 2,
) -> bool {
    std_repair_by_progress(
        sim,
        goal: goal,
        base_step: base_step,
        mechanic_divisor: mechanic_divisor,
        cycles_out: cycles_out,
        ticks: ticks,
    )
}

/// Cancel-safe fixed-cycle work loop (e.g. plunging/unclogging).
/// Returns `true` if all `target_cycles` completed without cancellation.
pub fn run_timed_cycles(target_cycles: i16, ticks: i16 = 2) -> bool {
    let mut cycles: i16 = 0;
    repeat target_cycles cancel_on_abort {
        sleep(ticks);
        cycles += 1;
    }
    return cycles >= target_cycles;
}
