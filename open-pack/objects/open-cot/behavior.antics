// Open Camp Cot (0x7F00_0002) — clean-room single folding cot.
// TTAB guards & interactions run on the Sim (`my`) with this cot in `stack_obj`.

bcon 4096 "CotTuning" {
    nap_cycles = 3,
    nap_ticks = 2,
    energy_step = 20,
    comfort_step = 5,
    max_energy = 80,
}

tree 4096 "Init" {
    my.attr[0] := 0;
    return true;
}

tree 4097 "Main" {
    return true;
}

tree 4098 "CanSleep" {
    if my.motive.energy < bcon.max_energy {
        return true;
    } else {
        return false;
    }
}

interaction 4099 "TakeNap" {
    stack.attr[0] := 1;
    play_sound(1, stack_obj);
    let cycles = 0;
    while cycles < bcon.nap_cycles {
        if my.person.priority == 0 {
            break;
        }
        idle(bcon.nap_ticks);
        if my.person.priority == 0 {
            break;
        }
        my.motive.energy += bcon.energy_step;
        my.motive.comfort += bcon.comfort_step;
        cycles += 1;
    }
    stack.attr[0] := 0;
    return true;
}
