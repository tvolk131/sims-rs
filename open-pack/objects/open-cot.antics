// Open Camp Cot (0x7F00_0002) — clean-room single folding cot.

use crate::templates::bed::BedBase;

object "Open Camp Cot" from BedBase {
    guid: 0x7F00_0002;
    price: 210;
    description: "A clean-room folding camp cot that restores Energy over multiple ticks.";
    sprite: Sprite::procedural("cot", primary: #587C60, accent: #E4E0D2, trim: #404844);

    wake_energy: 101;

    state occupied: bool = false;

    sound settle = preset("soft_thud", wav: "open_cot_settle");

    slot side_entry = routing([0.75, 0.0, 0.0], facing: east);

    interaction "Take a Nap" {
        autonomy: 65,
        attenuation: 0.015,
        advertises: [energy +60, comfort +20],
        lock: self.occupied,
        guard(sim) => sim.motive.energy < max_entry_energy,
        run(sim) {
            play_sound(settle);
            run_sleep_loop(sim);
        }
    }
}
