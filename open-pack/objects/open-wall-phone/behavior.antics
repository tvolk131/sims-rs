// Open Wall Phone (0x7F00_0030) — interactive dialog branching & FWAV phone SFX.
// TTAB guards & interactions run on the Sim (`my`) with this phone in `stack_obj`.
//
// Phone attributes (`stack.attr`):
//   attr[0] = in-use lock
//   attr[1] = last menu outcome (1=groceries ordered, 2=chatted, 3=info, 4=declined/canceled, 5=insufficient funds)
//   attr[2] = total completed calls

bcon 4096 "PhoneTuning" {
    grocery_cost = 40,
    grocery_stock_bonus = 4,
    chat_ticks = 2,
    chat_social_gain = 35,
    chat_fun_gain = 15,
    grocery_comfort_gain = 10,
    info_fun_gain = 10,
}

str 301 "PhoneDialogs" {
    title = "Open Wall Phone",
    menu_prompt = "Select a service: Order Groceries ($40), Chat with Neighbor, or Community Info.",
    btn_groceries = "Order Groceries",
    btn_chat = "Chat with Neighbor",
    btn_info = "Call for Info",
    confirm_groceries = "Order a fresh grocery delivery for $40?",
    btn_yes = "Order",
    btn_cancel = "Cancel",
    info_bulletin = "Community Bulletin: Bright skies and friendly neighbors today.",
}

tree 4096 "Init" {
    my.attr[0] := 0;
    my.attr[1] := 0;
    my.attr[2] := 0;
    return true;
}

tree 4097 "Main" {
    return true;
}

tree 4098 "CanUsePhone" {
    if stack.attr[0] != 0 {
        return false;
    }
    return true;
}

// Restocks any Open Fridge (0x7F00_0020) on the lot when groceries are delivered.
tree 4099 "RestockFridges" {
    let phone_id = stack_obj;
    let fridge = 0;
    while set_to_next(guid, 0x7F00_0020, dest: fridge) {
        stack_obj := fridge;
        stack.attr[0] += bcon.grocery_stock_bonus;
    }
    stack_obj := phone_id;
    return true;
}

tree 4100 "DeliverGroceries" {
    if alter_budget(bcon.grocery_cost, category: 0) {
        call RestockFridges();
        my.motive.comfort += bcon.grocery_comfort_gain;
        play_sound(3, stack_obj);
        stack.attr[1] := 1;
        stack.attr[2] += 1;
        return true;
    } else {
        stack.attr[1] := 5;
        return false;
    }
}

// 3-choice dialog: Button 1 = Order Groceries, Button 2 = Chat with Neighbor, Button 3 = Call for Info.
interaction 4101 "UsePhone" {
    stack.attr[0] := 1;
    play_sound(1, stack_obj);
    play_sound(2, stack_obj);

    if dialog(
        kind: yes_no_cancel,
        title: str.title,
        message: str.menu_prompt,
        button1: str.btn_groceries,
        button2: str.btn_chat,
        button3: str.btn_info,
        temp: 0,
        icon_mode: 1
    ) {
        if !call DeliverGroceries() {
            stack.attr[0] := 0;
            return false;
        }
    } else {
        if temp[0] == 0 {
            // Button 2: Chat with Neighbor
            idle(bcon.chat_ticks);
            my.motive.social += bcon.chat_social_gain;
            my.motive.fun += bcon.chat_fun_gain;
            play_sound(3, stack_obj);
            stack.attr[1] := 2;
            stack.attr[2] += 1;
        } else {
            // Button 3: Call for Info (non-blocking info bulletin)
            dialog(
                kind: ok,
                title: str.title,
                message: str.info_bulletin,
                inform: true,
                icon_mode: 1
            );
            my.motive.fun += bcon.info_fun_gain;
            play_sound(3, stack_obj);
            stack.attr[1] := 3;
            stack.attr[2] += 1;
        }
    }

    stack.attr[0] := 0;
    return true;
}

// 2-choice Yes/Cancel dialog for ordering groceries directly.
interaction 4102 "QuickOrderGroceries" {
    stack.attr[0] := 1;
    play_sound(2, stack_obj);
    if dialog(
        kind: yes_no,
        title: str.title,
        message: str.confirm_groceries,
        button1: str.btn_yes,
        button2: str.btn_cancel,
        icon_mode: 1
    ) {
        if !call DeliverGroceries() {
            stack.attr[0] := 0;
            return false;
        }
    } else {
        stack.attr[1] := 4;
    }
    stack.attr[0] := 0;
    return true;
}
