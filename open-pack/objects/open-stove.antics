// Open Hearth Stove (0x7F00_0022) — cooking range (OBJf functional cook) spawning Open Meal Plate.

use crate::objects::open_meal_plate::OpenMealPlate;
use std::math::min;

object "Open Hearth Stove" {
    guid: 0x7F00_0022;
    price: 490;
    category: appliances;
    description: "A clean-room kitchen range that scales meal nutrition with Cooking skill and spawns an Open Meal Plate.";
    sprite: Sprite::procedural("stove", primary: #DADEE4, accent: #949CA6, trim: #2E343C);

    param cook_score: i16 = 60;
    param cook_ticks: i16 = 2;
    param base_hunger_value: i16 = 30;
    param skill_divisor: i16 = 20;
    param max_nutrition: i16 = 95;

    state meals_cooked: i16 = 0;
    state occupied: bool = false;

    sound sizzle = preset("sizzle", wav: "open_stove_sizzle");

    slot front = routing([0.0, -0.75, 0.0]);

    functional cook(cooking_skill: i16, sim_id: ObjectId, plate_slot: i16, prep_bonus: i16) -> ObjectId {
        score: cook_score,
        guard(sim) => !self.occupied,
        run(sim) {
            // One cook at a time: the stove is taken until the plate is served or the cook fails.
            with lock(self.occupied) {
                play_sound(sizzle);
                sleep(cook_ticks);
                // A Sim whose action was cancelled while the pan was on serves nothing: the
                // fridge gives back the ingredients.
                if sim.priority == 0 {
                    return false;
                }

                let nutrition = min(cooking_skill / skill_divisor + base_hunger_value + prep_bonus, max_nutrition);

                let Some(plate) = create_object::<OpenMealPlate>(mode: stack_ahead, flags: 0x40) else {
                    return false;
                };
                plate.nutrition = nutrition;
                plate.is_full = true;
                self.meals_cooked += 1;
                return plate;
            }
        }
    }
}
