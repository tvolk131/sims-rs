// Open Privacy Shower (0x7F00_0040) — privacy guard, wear-to-broken, Mechanic-scaled repair.

use crate::common::helpers::{record_fixture_wear, repair_by_progress, restore_motive_loop};
use crate::templates::plumbing::PlumbingFixture;

object "Open Privacy Shower" from PlumbingFixture {
    guid: 0x7F00_0040;
    price: 520;
    description: "A clean-room tiled shower stall with privacy occupancy guards, wear-to-broken state transitions, and Mechanic-scaled repair.";
    sprite: Sprite::procedural("shower", primary: #DEE8EE, accent: #A4CEE0, trim: #84909A);

    param repair_goal: i16 = 100;
    param base_repair_step: i16 = 20;
    param mechanic_divisor: i16 = 20;

    state reserved: i16 = 0; // antics-lint: allow(unused_decl) keeps the attribute layout of saved lots
    state last_repair_cycles: i16 = 0;

    sound spray = preset("shower_spray", wav: "open_shower_spray");
    sound wrench = preset("wrench_clank", wav: "open_shower_wrench");
    sound fixed = preset("chime", wav: "open_shower_fixed");

    interaction "Take Shower" {
        autonomy: 55,
        advertises: [hygiene +95],
        lock: self.occupied,
        guard(sim) => !self.broken && sim.motive.hygiene < max_entry_motive,
        run(sim) {
            play_sound(spray);
            let cycles = restore_motive_loop(
                sim,
                Motive::Hygiene,
                cycles: max_use_cycles,
                step: motive_step,
                ticks: use_ticks,
            );
            if cycles > 0 && record_fixture_wear(&mut self.wear, &mut self.broken, break_threshold) {
                play_sound(wrench);
            }
        }
    }

    interaction "Repair Shower" {
        autonomy: 90,
        lock: self.occupied,
        guard(sim) => self.broken,
        run(sim) {
            play_sound(wrench);
            if repair_by_progress(
                sim,
                goal: repair_goal,
                base_step: base_repair_step,
                mechanic_divisor: mechanic_divisor,
                cycles_out: &mut self.last_repair_cycles,
                ticks: repair_ticks,
            ) {
                complete_fixture_repair(sim, fixed);
            }
        }
    }
}
