// Open Pine Bench (0x7F00_0001) — clean-room comfort bench.

bcon 4096 "BenchTuning" {
    rest_cycles = 4,
    comfort_step = 10,
    max_comfort = 95,
}

tree 4096 "Init" {
    my.attr[0] := 0;
    return true;
}

tree 4097 "Main" {
    return true;
}

tree 4098 "CanSit" {
    if my.attr[0] != 0 {
        return false;
    }
    if stack.motive.comfort >= bcon.max_comfort {
        return false;
    }
    return true;
}

interaction 4099 "SitAndRest" {
    my.attr[0] := 1;
    play_sound(1);
    let cycles = 0;
    while cycles < bcon.rest_cycles {
        stack.motive.comfort += bcon.comfort_step;
        cycles += 1;
    }
    my.attr[0] := 0;
    return true;
}
