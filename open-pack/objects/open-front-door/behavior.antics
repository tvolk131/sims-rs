// Open Oak Front Door (0x7F00_0080) — architectural entry with knock/welcome social
// interaction and lock/unlock state guards.
//
// Attributes (`stack.attr`):
//   attr[0] = occupancy lock (0 = free, 1 = busy)
//   attr[1] = welcomed guests counter
//   attr[2] = door lock state (0 = unlocked, 1 = locked)

bcon 4096 "FrontDoorTuning" {
    greet_ticks = 1,
    social_gain = 30,
    fun_gain = 10,
}

tree 4096 "Init" {
    my.attr[0] := 0;
    my.attr[1] := 0;
    my.attr[2] := 0;
    return true;
}

tree 4097 "Main" {
    return true;
}

tree 4098 "CanWelcome" {
    if stack.attr[0] != 0 {
        return false;
    }
    if stack.attr[2] != 0 {
        return false;
    }
    return true;
}

tree 4099 "CanLockDoor" {
    if stack.attr[0] != 0 {
        return false;
    }
    if stack.attr[2] != 0 {
        return false;
    }
    return true;
}

tree 4100 "CanUnlockDoor" {
    if stack.attr[0] != 0 {
        return false;
    }
    if stack.attr[2] == 0 {
        return false;
    }
    return true;
}

interaction 4101 "WelcomeGuest" {
    stack.attr[0] := 1;
    play_sound(1, stack_obj);
    idle(bcon.greet_ticks);
    play_sound(2, stack_obj);
    my.motive.social += bcon.social_gain;
    my.motive.fun += bcon.fun_gain;
    stack.attr[1] += 1;
    stack.attr[0] := 0;
    return true;
}

interaction 4102 "LockDoor" {
    stack.attr[2] := 1;
    play_sound(1, stack_obj);
    return true;
}

interaction 4103 "UnlockDoor" {
    stack.attr[2] := 0;
    play_sound(1, stack_obj);
    return true;
}
