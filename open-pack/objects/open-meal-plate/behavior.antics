// Open Meal Plate (0x7F00_0023) — cooked meal plate spawned on-lot by Open Hearth Stove.
// TTAB guards & interactions run on the Sim (`my`) with this plate in `stack_obj`.
//
// Plate attributes (`stack.attr`):
//   attr[0] = hunger nutrition value (set by stove based on Cooking skill)
//   attr[1] = full flag (1 = ready to eat, 0 = empty plate)

bcon 4096 "PlateTuning" {
    default_nutrition = 40,
    bite_ticks = 1,
    bites = 2,
}

tree 4096 "Init" {
    // Allow ground/floor height (data[4] bit 0) and both floor & terrain placement (data[42] bits 0..1).
    my.data[4] := 1;
    my.data[42] := 3;
    my.attr[0] := bcon.default_nutrition;
    my.attr[1] := 1;
    return true;
}

tree 4097 "Main" {
    return true;
}

tree 4098 "CanEat" {
    if stack.attr[1] == 1 {
        return true;
    }
    return false;
}

tree 4099 "CanClean" {
    if stack.attr[1] == 0 {
        return true;
    }
    return false;
}

interaction 4100 "DisposePlate" {
    play_sound(2, stack_obj);
    remove_object(stack_obj);
    return true;
}

interaction 4101 "EatMeal" {
    let per_bite = stack.attr[0];
    per_bite /= bcon.bites;
    let remainder = stack.attr[0];
    remainder %= bcon.bites;

    let eaten = 0;
    while eaten < bcon.bites {
        idle(bcon.bite_ticks);
        my.motive.hunger += per_bite;
        eaten += 1;
    }
    my.motive.hunger += remainder;
    play_sound(1, stack_obj);

    // Mark plate empty and dispose cleanly from the lot.
    stack.attr[1] := 0;
    call DisposePlate();
    return true;
}
