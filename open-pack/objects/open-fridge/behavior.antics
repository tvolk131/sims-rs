// Open Frost Fridge (0x7F00_0020) — initiates the multi-object cooking chain:
// Fridge (verify Counter + Stove, then debit funds + stock) -> Counter (prep)
// -> Stove (cook + skill scaling + on-lot plate creation) -> Meal Plate.
// TTAB guards & interactions run on the Sim (`my`) with this fridge in `stack_obj`.
//
// Fridge attributes (`stack.attr`):
//   attr[0] = pantry stock count (starts at 5; restocked by Open Wall Phone)
//   attr[1] = total meals prepared
//   attr[2] = object ID of the most recently created Open Meal Plate

bcon 4096 "FridgeTuning" {
    initial_stock = 5,
    meal_cost = 15,
    max_entry_hunger = 90,
    cooking_xp = 20,
}

tree 4096 "Init" {
    my.attr[0] := bcon.initial_stock;
    my.attr[1] := 0;
    my.attr[2] := 0;
    return true;
}

tree 4097 "Main" {
    return true;
}

tree 4098 "CanCookMeal" {
    if stack.attr[0] <= 0 {
        return false;
    }
    if my.motive.hunger >= bcon.max_entry_hunger {
        return false;
    }
    if !alter_budget(bcon.meal_cost, category: 0, test_only: true) {
        return false;
    }
    return true;
}

interaction 4099 "CookMeal" {
    let fridge_id = stack_obj;

    if stack.attr[0] <= 0 {
        return false;
    }

    // Locate both Counter (prep) and Stove (cook) BEFORE debiting funds or stock
    // so missing appliances never consume household money or ingredients.
    if !find_best_object(prep) {
        stack_obj := fridge_id;
        return false;
    }
    let counter_id = stack_obj;

    if !find_best_object(cook) {
        stack_obj := fridge_id;
        return false;
    }
    let stove_id = stack_obj;

    // Debit meal cost and decrement fridge stock.
    if !alter_budget(bcon.meal_cost, category: 0) {
        stack_obj := fridge_id;
        return false;
    }
    stack_obj := fridge_id;
    stack.attr[0] -= 1;
    play_sound(1, stack_obj);

    // Pass Sim's cooking skill (temp[0]), Sim ID (temp[1]), plate output slot (temp[2]),
    // and counter prep bonus (temp[3]) into downstream functional trees.
    temp[0] := my.person.cooking;
    temp[1] := my.id;
    temp[2] := 0;
    temp[3] := 0;

    // Step 1: Prep ingredients on the located Counter.
    stack_obj := counter_id;
    if !run_functional_tree(prep) {
        stack_obj := fridge_id;
        stack.attr[0] += 1;
        alter_budget(bcon.meal_cost, category: 0, income: true);
        return false;
    }

    // Step 2: Cook on the located Stove and place the Open Meal Plate on the lot.
    stack_obj := stove_id;
    if !run_functional_tree(cook) {
        stack_obj := fridge_id;
        stack.attr[0] += 1;
        alter_budget(bcon.meal_cost, category: 0, income: true);
        return false;
    }

    // Step 3: Record newly created Meal Plate ID and award Cooking skill experience.
    stack_obj := fridge_id;
    stack.attr[2] := temp[2];
    stack.attr[1] += 1;
    my.person.cooking += bcon.cooking_xp;
    return true;
}
