// Open Wall Phone (0x7F00_0030) — interactive dialog branching & FWAV phone SFX.

use crate::objects::open_fridge::OpenFrostFridge;

object "Open Wall Phone" {
    guid: 0x7F00_0030;
    price: 95;
    category: electronics;
    description: "A clean-room wall telephone with interactive choice dialogs for neighbor calls, grocery delivery, and community info.";
    sprite: Sprite::procedural("wall_phone", primary: #36485C, accent: #D4DAE0, trim: #222A34);

    enum CallOutcome {
        None = 0,
        Groceries = 1,
        Chat = 2,
        Info = 3,
        Cancelled = 4,
        InsufficientFunds = 5,
    }

    param grocery_cost: i16 = 40;
    param grocery_stock_bonus: i16 = 4;
    param chat_ticks: i16 = 2;
    param chat_social_gain: i16 = 35;
    param chat_fun_gain: i16 = 15;
    param grocery_comfort_gain: i16 = 10;
    param info_fun_gain: i16 = 10;

    state occupied: bool = false;
    state last_outcome: CallOutcome = CallOutcome::None;
    state completed_calls: i16 = 0;

    sound ring = preset("phone_ring", wav: "open_phone_ring");
    sound dial = preset("phone_dial", wav: "open_phone_dial");
    sound confirm = preset("chime", wav: "open_phone_confirm");

    slot front = routing([0.0, -0.65, 0.0]);

    fn deliver_groceries(sim: Sim) -> bool {
        if debit_funds(grocery_cost) {
            for fridge in objects_of::<OpenFrostFridge>() {
                fridge.stock += grocery_stock_bonus;
            }
            sim.motive.comfort += grocery_comfort_gain;
            play_sound(confirm);
            self.last_outcome = CallOutcome::Groceries;
            self.completed_calls += 1;
            return true;
        }
        self.last_outcome = CallOutcome::InsufficientFunds;
        return false;
    }

    interaction "Use Phone" {
        autonomy: 80,
        advertises: [social +40, fun +15],
        lock: self.occupied,
        run(sim) {
            play_sound(ring);
            play_sound(dial);

            match dialog(
                kind: yes_no_cancel,
                title: "Open Wall Phone",
                message: "Select a service: Order Groceries ($40), Chat with Neighbor, or Community Info.",
                buttons: ("Order Groceries", "Chat with Neighbor", "Call for Info"),
                icon_mode: 1,
            ) {
                Button1 => {
                    if !deliver_groceries(sim) {
                        return false;
                    }
                }
                Button2 => {
                    sleep(chat_ticks);
                    sim.motive.social += chat_social_gain;
                    sim.motive.fun += chat_fun_gain;
                    play_sound(confirm);
                    self.last_outcome = CallOutcome::Chat;
                    self.completed_calls += 1;
                }
                Button3 => {
                    dialog(
                        kind: ok,
                        title: "Open Wall Phone",
                        message: "Community Bulletin: Bright skies and friendly neighbors today.",
                        inform: true,
                        icon_mode: 1,
                    );
                    sim.motive.fun += info_fun_gain;
                    play_sound(confirm);
                    self.last_outcome = CallOutcome::Info;
                    self.completed_calls += 1;
                }
            }
        }
    }

    interaction "Order Groceries" {
        autonomy: 95,
        lock: self.occupied,
        run(sim) {
            play_sound(dial);
            match dialog(
                kind: yes_no,
                title: "Open Wall Phone",
                message: "Order a fresh grocery delivery for $40?",
                buttons: ("Order", "Cancel"),
                icon_mode: 1,
            ) {
                Yes => {
                    if !deliver_groceries(sim) {
                        return false;
                    }
                }
                No => {
                    self.last_outcome = CallOutcome::Cancelled;
                }
            }
        }
    }
}
