// Open Dining Chair (0x7F00_0061) — Comfort seating with occupancy lock and player cancel safety.
//
// Attributes (`stack.attr`):
//   attr[0] = occupancy lock (0 = vacant, 1 = occupied)

bcon 4096 "DiningChairTuning" {
    sit_ticks = 2,
    sit_cycles = 3,
    comfort_step = 18,
    max_entry_comfort = 95,
}

tree 4096 "Init" {
    my.attr[0] := 0;
    return true;
}

tree 4097 "Main" {
    return true;
}

tree 4098 "CanSitChair" {
    if stack.attr[0] != 0 {
        return false;
    }
    if my.motive.comfort >= bcon.max_entry_comfort {
        return false;
    }
    return true;
}

interaction 4099 "SitChair" {
    stack.attr[0] := 1;
    play_sound(1, stack_obj);

    let cycles = 0;
    while cycles < bcon.sit_cycles {
        if my.person.priority == 0 {
            break;
        }
        idle(bcon.sit_ticks);
        if my.person.priority == 0 {
            break;
        }
        my.motive.comfort += bcon.comfort_step;
        cycles += 1;
        if my.motive.comfort >= 100 {
            break;
        }
    }

    stack.attr[0] := 0;
    return true;
}
