// Open Timber Bookshelf (0x7F00_0053) — Fun reading + Cooking & Mechanical skill study.

use crate::common::helpers::{gain_skill, restore_motive_loop};

object "Open Timber Bookshelf" {
    guid: 0x7F00_0053;
    price: 340;
    category: misc;
    description: "A clean-room hardwood bookcase for reading novels (Fun) and studying Cooking or Mechanical skills.";
    sprite: Sprite::procedural("bookshelf", primary: #845A38, accent: #AE5848, trim: #4A3422);

    param read_ticks: i16 = 2;
    param read_cycles: i16 = 3;
    param novel_fun_step: i16 = 20;
    param study_cycles: i16 = 3;
    param study_skill_step: i16 = 25;
    param study_fun_step: i16 = 6;
    param max_skill: i16 = 1000;

    state occupied: bool = false;
    state sessions: i16 = 0;

    sound page_turn = preset("ui_click", wav: "open_book_turn");
    sound skill_chime = preset("chime", wav: "open_skill_chime");

    slot front = routing([0.0, -0.75, 0.0]);

    fn study_skill(sim: Sim, skill: Skill) {
        play_sound(page_turn);
        let mut cycles: i16 = 0;
        repeat study_cycles cancel_on_abort {
            sleep(read_ticks);
            gain_skill(sim, skill, study_skill_step, max: max_skill);
            sim.motive.fun += study_fun_step;
            cycles += 1;
        }
        if cycles > 0 {
            play_sound(skill_chime);
            self.sessions += 1;
        }
    }

    interaction "Read Novel" {
        autonomy: 50,
        advertises: [fun +55],
        lock: self.occupied,
        run(sim) {
            play_sound(page_turn);
            restore_motive_loop(sim, Motive::Fun, cycles: read_cycles, step: novel_fun_step, ticks: read_ticks);
            self.sessions += 1;
        }
    }

    interaction "Study Cooking" {
        autonomy: 35,
        advertises: [fun +15],
        lock: self.occupied,
        run(sim) {
            study_skill(sim, Skill::Cooking);
        }
    }

    interaction "Study Mechanical" {
        autonomy: 35,
        advertises: [fun +15],
        lock: self.occupied,
        run(sim) {
            study_skill(sim, Skill::Mechanical);
        }
    }
}
