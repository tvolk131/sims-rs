// Open Dining Table (0x7F00_0060) — dining surface with container slot and set/tidy states; a
// set table raises its room's score through its room impact.

use std::engine::RefreshMode;

object "Open Dining Table" {
    guid: 0x7F00_0060;
    price: 260;
    category: surfaces;
    description: "A clean-room solid wood dining table with a serving surface and quick refreshment interaction.";
    sprite: Sprite::procedural("table", primary: #A67648, accent: #CCA272, trim: #583C24);

    param action_ticks: i16 = 1;
    /// The room impact (object data word 7) while the table is set: the room score counts it.
    param set_room_impact: i16 = 3;

    state occupied: bool = false;
    state is_set: bool = false;

    sound tap = preset("wood_creak", wav: "open_table_tap");

    slot top_surface = container([0.0, 0.0, 0.65]);
    slot front = routing([0.0, -0.75, 0.0], sitting: true);

    fn toggle_table_setting(set_state: bool) {
        play_sound(tap);
        sleep(action_ticks);
        self.is_set = set_state;
        if set_state {
            self.room_impact = set_room_impact;
        } else {
            self.room_impact = 0;
        }
        // The room keeps its score until it is recounted.
        self.refresh(RefreshMode::RecountRoom);
    }

    interaction "Set Table" {
        autonomy: 30,
        advertises: [room +30],
        lock: self.occupied,
        guard(sim) => !self.is_set,
        run(sim) {
            toggle_table_setting(true);
        }
    }

    interaction "Tidy Table" {
        autonomy: 40,
        lock: self.occupied,
        guard(sim) => self.is_set,
        run(sim) {
            toggle_table_setting(false);
        }
    }
}
