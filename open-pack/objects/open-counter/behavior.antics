// Open Oak Counter (0x7F00_0021) — kitchen prep surface (OBJf callback 18 / 0x12).
//
// Data/Attributes:
//   data[31] (prep_score) = 50 (advertised to find_best_object(prep))
//   attr[0] = total meals prepped on this counter
//   attr[1] = occupied flag (0 = clean/free)

bcon 4096 "CounterTuning" {
    prep_score = 50,
    prep_nutrition_bonus = 10,
}

tree 4096 "Init" {
    my.prep_score := bcon.prep_score;
    my.attr[0] := 0;
    my.attr[1] := 0;
    return true;
}

tree 4097 "Main" {
    return true;
}

// Check tree run by find_best_object(prep): stack_obj is this counter.
tree 4098 "CanPrep" {
    if stack.attr[1] != 0 {
        return false;
    }
    return true;
}

// Functional callback 18 (0x12): me is Sim, stack_obj is this counter.
tree 4099 "PrepIngredients" {
    stack.attr[0] += 1;
    temp[3] := bcon.prep_nutrition_bonus;
    play_sound(1, stack_obj);
    return true;
}
