// Open Floor Lamp (0x7F00_0070) — toggleable warm lighting with off/on graphics; a lit lamp
// raises its room's score (and so the Room of everyone in it) through its room impact.

use crate::templates::toggle::ToggleablePower;
use std::engine::RefreshMode;

object "Open Floor Lamp" from ToggleablePower {
    guid: 0x7F00_0070;
    price: 110;
    category: lighting;
    description: "A clean-room standing floor lamp with toggleable warm light that boosts Room mood.";
    graphics: [
        Sprite::procedural("floor_lamp", primary: #F2E0AE, accent: #FCF0CE, trim: #745E3E),
        Sprite::procedural("floor_lamp", primary: #988C74, accent: #B4A890, trim: #604E34),
    ];

    initial_power: true;
    /// The room impact (object data word 7) while lit: the room score counts it.
    param lit_room_impact: i16 = 5;

    sound switch_click = preset("ui_click", wav: "open_lamp_switch");

    slot front = routing([0.0, -0.65, 0.0]);

    init {
        if self.power {
            self.room_impact = lit_room_impact;
        }
    }

    fn on_power_changed(sim: Sim, on: bool) {
        if on {
            set_graphic(0);
            self.room_impact = lit_room_impact;
        } else {
            set_graphic(1);
            self.room_impact = 0;
        }
        // The room keeps its score until it is recounted.
        self.refresh(RefreshMode::RecountRoom);
    }

    interaction "Turn On Light" {
        autonomy: 40,
        advertises: [room +40],
        guard(sim) => !self.power,
        run(sim) {
            apply_power(sim, true);
        }
    }

    interaction "Turn Off Light" {
        autonomy: 15,
        guard(sim) => self.power,
        run(sim) {
            apply_power(sim, false);
        }
    }
}
