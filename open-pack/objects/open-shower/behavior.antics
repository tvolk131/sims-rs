// Open Privacy Shower (0x7F00_0040) — privacy guard, wear-to-broken transition,
// mutually exclusive Use / Repair guard trees, Mechanic-skill-scaled repair,
// and native VM player cancel cleanup (`my.person.priority == 0`).
//
// Shower attributes (`stack.attr` inside TTAB guards/interactions):
//   attr[0] = occupancy / privacy lock (0 = vacant, 1 = occupied)
//   attr[1] = wear counter (breaks when wear >= bcon.break_threshold)
//   attr[2] = broken state (0 = working, 1 = broken)
//   attr[4] = last repair cycle count (observable metric for skill scaling)

bcon 4096 "ShowerTuning" {
    break_threshold = 3,
    spray_ticks = 2,
    max_wash_cycles = 4,
    hygiene_step = 35,
    max_entry_hygiene = 95,
    repair_ticks = 2,
    repair_goal = 100,
    base_repair_step = 20,
    mechanic_divisor = 20,
    mechanic_xp = 15,
}

tree 4096 "Init" {
    my.attr[0] := 0;
    my.attr[1] := 0;
    my.attr[2] := 0;
    my.attr[3] := 0;
    my.attr[4] := 0;
    return true;
}

tree 4097 "Main" {
    return true;
}

// Guard for "Take Shower": blocked when broken, occupied, or already clean.
tree 4098 "CanTakeShower" {
    if stack.attr[2] != 0 {
        return false;
    }
    if stack.attr[0] != 0 {
        return false;
    }
    if my.motive.hygiene >= bcon.max_entry_hygiene {
        return false;
    }
    return true;
}

// Guard for "Repair Shower": enabled ONLY when broken and not occupied.
tree 4099 "CanRepairShower" {
    if stack.attr[2] == 0 {
        return false;
    }
    if stack.attr[0] != 0 {
        return false;
    }
    return true;
}

interaction 4100 "TakeShower" {
    stack.attr[0] := 1;
    play_sound(1, stack_obj);

    let cycles = 0;
    while cycles < bcon.max_wash_cycles {
        if my.person.priority == 0 {
            break;
        }
        idle(bcon.spray_ticks);
        if my.person.priority == 0 {
            break;
        }
        my.motive.hygiene += bcon.hygiene_step;
        cycles += 1;
        if my.motive.hygiene >= 100 {
            break;
        }
    }

    // Apply wear only when at least one wash cycle completed.
    if cycles > 0 {
        stack.attr[1] += 1;
        if stack.attr[1] >= bcon.break_threshold {
            stack.attr[2] := 1;
            play_sound(2, stack_obj);
        }
    }

    // Clean state reset even on player cancel.
    stack.attr[0] := 0;
    return true;
}

interaction 4101 "RepairShower" {
    stack.attr[0] := 1;
    play_sound(2, stack_obj);

    // Repair speed scales with the Sim's Mechanical skill (person.data[12]).
    let step = my.person.mechanical;
    step /= bcon.mechanic_divisor;
    step += bcon.base_repair_step;

    let progress = 0;
    let cycles = 0;
    while progress < bcon.repair_goal {
        if my.person.priority == 0 {
            break;
        }
        idle(bcon.repair_ticks);
        if my.person.priority == 0 {
            break;
        }
        progress += step;
        cycles += 1;
    }

    stack.attr[4] := cycles;
    if progress >= bcon.repair_goal {
        stack.attr[2] := 0;
        stack.attr[1] := 0;
        my.person.mechanical += bcon.mechanic_xp;
        play_sound(3, stack_obj);
    }

    // Clean state reset even on mid-repair player cancel.
    stack.attr[0] := 0;
    return true;
}
