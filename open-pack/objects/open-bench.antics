// Open Pine Bench (0x7F00_0001) — clean-room comfort bench.

use crate::templates::seat::SeatBase;

object "Open Pine Bench" from SeatBase {
    guid: 0x7F00_0001;
    price: 120;
    description: "A clean-room pine wood bench that restores Comfort.";
    sprite: Sprite::procedural("bench", primary: #9C6A3E, accent: #CEA26E, trim: #4C3420);

    sit_cycles: 4;
    comfort_step: 10;
    max_entry_comfort: 95;

    sound creak = preset("wood_creak", wav: "open_bench_creak");

    interaction "Sit and Rest" {
        autonomy: 55,
        attenuation: 0.02,
        advertises: [
            comfort +45 (min: -100),
        ],
        guard(sim) => !self.occupied && sim.motive.comfort < max_entry_comfort,
        run(sim) {
            with lock(self.occupied) {
                play_sound(creak, self);
                repeat sit_cycles {
                    sim.motive.comfort += comfort_step;
                }
            }
            return true;
        }
    }
}
