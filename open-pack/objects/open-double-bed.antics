// Open Double Bed (master 0x7F00_0012, lead 0x7F00_0010, slave 0x7F00_0011)
// Multi-tile double bed with left/right entry slots, synced tile occupancy, and cancel cleanup.

use crate::templates::bed::BedBase;

object "Open Double Bed" from BedBase {
    guid: 0x7F00_0012;
    price: 680;
    description: "A clean-room two-tile double bed with left/right entry slots, shared occupancy tracking, and player cancel cleanup.";
    sprite: Sprite::procedural("double_bed", primary: #4C6C92, accent: #ECE8DC, trim: #5E3E2A);

    bitflags BedSide {
        Left = 1,
        Right = 2,
    }

    master_id: 1;
    tiles: [
        tile {
            name: "Open Double Bed (Left Lead)",
            guid: 0x7F00_0010,
            objd_id: 129,
            offset: [0, 0],
            lead: true,
            interaction_group: -1,
            dgrp_id: 101,
            shape: "double_bed_left",
        },
        tile {
            name: "Open Double Bed (Right Slave)",
            guid: 0x7F00_0011,
            objd_id: 130,
            offset: [1, 0],
            lead: false,
            interaction_group: 1,
            dgrp_id: 102,
            shape: "double_bed_right",
        },
    ];

    sleep_cycles: 5;
    energy_step: 24;
    comfort_step: 10;
    max_entry_energy: 85;
    wake_energy: 95;

    state occupancy: BedSide = BedSide::None;
    state reserved: i16 = 0; // antics-lint: allow(unused_decl) keeps the attribute layout of saved lots
    state completed_cycles: i16 = 0;

    sound settle = preset("soft_thud", wav: "open_double_bed_settle");
    sound wake = preset("wood_creak", wav: "open_double_bed_wake");

    slot left_entry = routing([-0.85, 0.0, 0.0], facing: west);
    slot right_entry = routing([1.85, 0.0, 0.0], facing: east);

    fn sync_occupancy() {
        for part in self.parts() {
            part.occupancy = self.occupancy;
        }
    }

    fn sleep_side(sim: Sim, side: BedSide) {
        self.occupancy.set(side);
        sync_occupancy();
        defer {
            self.occupancy.clear(side);
            sync_occupancy();
            play_sound(wake);
        }
        play_sound(settle);
        run_sleep_loop_tracked(sim, &mut self.completed_cycles);
    }

    interaction "Sleep (Left Side)" {
        autonomy: 60,
        attenuation: 0.015,
        advertises: [energy +90, comfort +40],
        guard(sim) => !self.occupancy.contains(BedSide::Left) && sim.motive.energy < max_entry_energy,
        run(sim) {
            sleep_side(sim, BedSide::Left);
        }
    }

    interaction "Sleep (Right Side)" {
        autonomy: 60,
        attenuation: 0.015,
        advertises: [energy +90, comfort +40],
        guard(sim) => !self.occupancy.contains(BedSide::Right) && sim.motive.energy < max_entry_energy,
        run(sim) {
            sleep_side(sim, BedSide::Right);
        }
    }
}
