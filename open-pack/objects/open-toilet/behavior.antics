// Open Porcelain Toilet (0x7F00_0050) — Bladder relief, flush SFX, clog/unclog guard,
// and native player cancel cleanup (`my.person.priority == 0`).
//
// Attributes (`stack.attr`):
//   attr[0] = occupancy lock (0 = free, 1 = occupied)
//   attr[1] = uses since last unclog
//   attr[2] = clogged state (0 = clear, 1 = clogged)

bcon 4096 "ToiletTuning" {
    clog_threshold = 4,
    use_ticks = 2,
    use_cycles = 2,
    bladder_step = 55,
    max_entry_bladder = 92,
    unclog_ticks = 2,
    unclog_cycles = 3,
    mechanic_xp = 12,
}

tree 4096 "Init" {
    my.attr[0] := 0;
    my.attr[1] := 0;
    my.attr[2] := 0;
    return true;
}

tree 4097 "Main" {
    return true;
}

tree 4098 "CanUseToilet" {
    if stack.attr[2] != 0 {
        return false;
    }
    if stack.attr[0] != 0 {
        return false;
    }
    if my.motive.bladder >= bcon.max_entry_bladder {
        return false;
    }
    return true;
}

tree 4099 "CanUnclogToilet" {
    if stack.attr[2] == 0 {
        return false;
    }
    if stack.attr[0] != 0 {
        return false;
    }
    return true;
}

interaction 4100 "UseToilet" {
    stack.attr[0] := 1;
    let cycles = 0;
    while cycles < bcon.use_cycles {
        if my.person.priority == 0 {
            break;
        }
        idle(bcon.use_ticks);
        if my.person.priority == 0 {
            break;
        }
        my.motive.bladder += bcon.bladder_step;
        cycles += 1;
        if my.motive.bladder >= 100 {
            break;
        }
    }

    if cycles > 0 {
        play_sound(1, stack_obj);
        stack.attr[1] += 1;
        if stack.attr[1] >= bcon.clog_threshold {
            stack.attr[2] := 1;
        }
    }

    stack.attr[0] := 0;
    return true;
}

interaction 4101 "UnclogToilet" {
    stack.attr[0] := 1;
    play_sound(2, stack_obj);

    let cycles = 0;
    while cycles < bcon.unclog_cycles {
        if my.person.priority == 0 {
            break;
        }
        idle(bcon.unclog_ticks);
        if my.person.priority == 0 {
            break;
        }
        cycles += 1;
    }

    if cycles >= bcon.unclog_cycles {
        stack.attr[2] := 0;
        stack.attr[1] := 0;
        my.person.mechanical += bcon.mechanic_xp;
        play_sound(1, stack_obj);
    }

    stack.attr[0] := 0;
    return true;
}
