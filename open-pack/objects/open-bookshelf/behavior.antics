// Open Timber Bookshelf (0x7F00_0053) — Fun reading + Cooking & Mechanical skill study
// with occupancy lock (attr[0]) and player cancel safety.
//
// Attributes (`stack.attr`):
//   attr[0] = occupancy lock (0 = free, 1 = in use)
//   attr[1] = total study/reading sessions completed

bcon 4096 "BookshelfTuning" {
    read_ticks = 2,
    read_cycles = 3,
    novel_fun_step = 20,
    study_cycles = 3,
    study_skill_step = 25,
    study_fun_step = 6,
    max_skill = 1000,
}

tree 4096 "Init" {
    my.attr[0] := 0;
    my.attr[1] := 0;
    return true;
}

tree 4097 "Main" {
    return true;
}

tree 4098 "CanUseBookshelf" {
    if stack.attr[0] != 0 {
        return false;
    }
    return true;
}

interaction 4099 "ReadNovel" {
    stack.attr[0] := 1;
    play_sound(1, stack_obj);

    let cycles = 0;
    while cycles < bcon.read_cycles {
        if my.person.priority == 0 {
            break;
        }
        idle(bcon.read_ticks);
        if my.person.priority == 0 {
            break;
        }
        my.motive.fun += bcon.novel_fun_step;
        cycles += 1;
        if my.motive.fun >= 100 {
            break;
        }
    }

    stack.attr[1] += 1;
    stack.attr[0] := 0;
    return true;
}

interaction 4100 "StudyCooking" {
    stack.attr[0] := 1;
    play_sound(1, stack_obj);

    let cycles = 0;
    while cycles < bcon.study_cycles {
        if my.person.priority == 0 {
            break;
        }
        idle(bcon.read_ticks);
        if my.person.priority == 0 {
            break;
        }
        if my.person.cooking < bcon.max_skill {
            my.person.cooking += bcon.study_skill_step;
        }
        my.motive.fun += bcon.study_fun_step;
        cycles += 1;
    }

    if cycles > 0 {
        play_sound(2, stack_obj);
        stack.attr[1] += 1;
    }
    stack.attr[0] := 0;
    return true;
}

interaction 4101 "StudyMechanical" {
    stack.attr[0] := 1;
    play_sound(1, stack_obj);

    let cycles = 0;
    while cycles < bcon.study_cycles {
        if my.person.priority == 0 {
            break;
        }
        idle(bcon.read_ticks);
        if my.person.priority == 0 {
            break;
        }
        if my.person.mechanical < bcon.max_skill {
            my.person.mechanical += bcon.study_skill_step;
        }
        my.motive.fun += bcon.study_fun_step;
        cycles += 1;
    }

    if cycles > 0 {
        play_sound(2, stack_obj);
        stack.attr[1] += 1;
    }
    stack.attr[0] := 0;
    return true;
}
