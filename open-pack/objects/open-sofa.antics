// Open Plush Sofa (0x7F00_0051) — Comfort relax, Energy nap, and Social chat seating.

use crate::common::helpers::restore_two_motives_loop;
use crate::templates::seat::SeatBase;

object "Open Plush Sofa" from SeatBase {
    guid: 0x7F00_0051;
    price: 420;
    description: "A clean-room upholstered living room sofa for relaxing, napping, and casual chatting.";
    sprite: Sprite::procedural("sofa", primary: #5C8098, accent: #84A4B8, trim: #583E2A);

    comfort_step: 24;
    max_entry_comfort: 100;

    param nap_cycles: i16 = 3;
    param nap_energy_step: i16 = 18;
    param nap_comfort_step: i16 = 12;
    param max_nap_energy: i16 = 85;
    param chat_cycles: i16 = 2;
    param chat_social_step: i16 = 22;
    param chat_comfort_step: i16 = 14;

    state sessions: i16 = 0;

    sound creak = preset("wood_creak", wav: "open_sofa_creak");
    sound chime = preset("chime", wav: "open_sofa_chime");

    interaction "Relax" {
        autonomy: 55,
        advertises: [comfort +65],
        lock: self.occupied,
        guard(sim) => sim.motive.comfort < max_entry_comfort,
        run(sim) {
            play_sound(creak);
            sit_comfort_loop(sim);
            self.sessions += 1;
        }
    }

    interaction "Take Nap" {
        autonomy: 50,
        advertises: [energy +45, comfort +35],
        lock: self.occupied,
        guard(sim) => sim.motive.energy < max_nap_energy,
        run(sim) {
            play_sound(creak);
            restore_two_motives_loop(
                sim,
                Motive::Energy,
                nap_energy_step,
                Motive::Comfort,
                nap_comfort_step,
                cycles: nap_cycles,
                ticks: sit_ticks,
                primary_cap: 95,
            );
            self.sessions += 1;
        }
    }

    interaction "Chat on Sofa" {
        autonomy: 45,
        advertises: [social +40, comfort +30],
        lock: self.occupied,
        run(sim) {
            play_sound(chime);
            restore_two_motives_loop(
                sim,
                Motive::Social,
                chat_social_step,
                Motive::Comfort,
                chat_comfort_step,
                cycles: chat_cycles,
                ticks: sit_ticks,
                primary_cap: 101,
            );
            self.sessions += 1;
        }
    }
}
